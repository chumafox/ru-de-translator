/* Stylesheet for Ru-De Translator */

Screen {
    background: #0f0f17;
    color: #e0e0e9;
}

Header {
    background: #181825;
    color: #cba6f7;
    text-style: bold;
    border-bottom: solid #313244;
}

Footer {
    background: #181825;
    color: #a6adc8;
}

#main-container {
    padding: 1 2;
    layout: vertical;
}

.section-title {
    color: #89b4fa;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 0;
}

Input {
    background: #1e1e2e;
    color: #cdd6f4;
    border: tall #45475a;
    margin-bottom: 1;
}

Input:focus {
    border: tall #b4befe;
}

#result-container {
    background: #1e1e2e;
    border: tall #313244;
    height: 6;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 1;
    content-align: center middle;
}

#result-text {
    color: #a6e3a1;
    text-style: bold;
    text-align: center;
}

#buttons-layout {
    layout: grid;
    grid-size: 4;
    grid-columns: 1fr 1fr 1fr 1fr;
    grid-gutter: 1 2;
    height: 3;
    margin-top: 1;
}

Button {
    width: 100%;
    background: #313244;
    color: #cdd6f4;
    border: none;
}

Button:hover {
    background: #45475a;
    color: #f5c2e7;
}

#btn-translate {
    background: #89b4fa;
    color: #11111b;
    text-style: bold;
}

#btn-translate:hover {
    background: #b4befe;
}

#btn-speak {
    background: #a6e3a1;
    color: #11111b;
    text-style: bold;
}

#btn-speak:hover {
    background: #a6e3a1 80%;
}

#btn-stop {
    background: #f38ba8;
    color: #11111b;
    text-style: bold;
}

#btn-stop:hover {
    background: #f38ba8 80%;
}

#btn-settings {
    background: #f9e2af;
    color: #11111b;
    text-style: bold;
}

#btn-settings:hover {
    background: #f9e2af 80%;
}

/* Settings Modal Dialog */
SettingsScreen {
    align: center middle;
}

#settings-dialog {
    width: 70;
    height: 42;
    background: #1e1e2e;
    border: thick #b4befe;
    padding: 1 3;
}

#settings-scroll-container {
    height: 31;
    margin-bottom: 1;
    scrollbar-size: 1 1;
}

#settings-tts-static-label {
    background: #1e1e2e;
    color: #a6e3a1;
    border: tall #313244;
    padding: 0 1;
    height: 3;
    content-align: left middle;
    margin-bottom: 1;
}

#settings-title {
    text-align: center;
    color: #f5c2e7;
    text-style: bold;
    margin-bottom: 1;
}

.settings-label {
    color: #89b4fa;
    margin-top: 1;
}

.settings-input {
    width: 100%;
    margin-bottom: 0;
}

.settings-select {
    width: 100%;
}

#settings-buttons {
    layout: horizontal;
    height: 3;
    margin-top: 2;
    align: right middle;
}

#settings-buttons Button {
    width: 15;
    margin-left: 2;
}

#btn-save-settings {
    background: #a6e3a1;
    color: #11111b;
    text-style: bold;
}

#btn-cancel-settings {
    background: #f38ba8;
    color: #11111b;
    text-style: bold;
}

#status-msg {
    color: #fab387;
    text-align: center;
    margin-top: 1;
}


